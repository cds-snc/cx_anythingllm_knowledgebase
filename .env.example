# AnythingLLM configuration template
# Copy to .env and fill in your values
# DO NOT commit .env — it is gitignored

SERVER_PORT=3001
STORAGE_DIR="/app/server/storage"

# --- Secrets: generate with `openssl rand -hex 32` ---
SIG_KEY='REPLACE_WITH_32_CHAR_RANDOM_STRING'
SIG_SALT='REPLACE_WITH_32_CHAR_RANDOM_STRING'
JWT_SECRET="REPLACE_WITH_24_CHAR_RANDOM_STRING"
JWT_EXPIRY="7d"

# --- LLM: OpenAI ---
LLM_PROVIDER='openai'
OPEN_AI_KEY=your-openai-api-key-here
OPEN_MODEL_PREF='gpt-4o-mini'

# --- Embedder: OpenAI ---
EMBEDDING_ENGINE='openai'
EMBEDDING_MODEL_PREF='text-embedding-3-small'

# --- Vector DB: LanceDB (built-in, no external service) ---
VECTOR_DB="lancedb"

# --- Transcription (built-in) ---
WHISPER_PROVIDER="local"

# --- TTS (built-in) ---
TTS_PROVIDER="native"

# --- Security ---
DISABLE_SWAGGER_DOCS="true"
