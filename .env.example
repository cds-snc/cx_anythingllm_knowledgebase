# AnythingLLM configuration template
# Copy to .env and fill in your values
# DO NOT commit .env — it is gitignored

SERVER_PORT=3001
STORAGE_DIR="/app/server/storage"

# --- Secrets: generate with `openssl rand -hex 32` ---
SIG_KEY='REPLACE_WITH_32_CHAR_RANDOM_STRING'
SIG_SALT='REPLACE_WITH_32_CHAR_RANDOM_STRING'
JWT_SECRET="REPLACE_WITH_24_CHAR_RANDOM_STRING"
JWT_EXPIRY="7d"

# --- LLM: Azure OpenAI ---
LLM_PROVIDER='azure'
AZURE_OPENAI_ENDPOINT='https://your-resource.openai.azure.com/'
AZURE_OPENAI_APIKEY=your-azure-openai-api-key-here
AZURE_OPENAI_MODEL_VERSION='2024-08-01-preview'
OPEN_AI_KEY=your-azure-openai-api-key-here
OPEN_MODEL_PREF='gpt-4o'

# --- Embedder: native (runs locally in container, no API key needed) ---
EMBEDDING_ENGINE='native'

# --- Vector DB: LanceDB (built-in, no external service) ---
VECTOR_DB="lancedb"

# --- Transcription (built-in) ---
WHISPER_PROVIDER="local"

# --- TTS (built-in) ---
TTS_PROVIDER="native"

# --- Security ---
DISABLE_SWAGGER_DOCS="true"

# --- AnythingLLM API key (generate in Settings → Developer API after onboarding) ---
ANYWHERE_API_KEY=your-anythingllm-api-key-here
